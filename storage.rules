rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Walkie Talkie audio — unauthenticated (WT pages have no login)
    match /wt_audio/{bizId}/{fileName} {
      allow read, write: if true;
    }

    // EP HUB Channel audio — unauthenticated (channel pages have no login)
    match /hub_audio/{channelId}/{fileName} {
      allow read, write: if true;
    }

    // EP HUB Channel images (flyers, invitations) — unauthenticated
    match /hub_images/{channelId}/{fileName} {
      allow read, write: if true;
    }

    // Logos & icons are public assets shown to unauthenticated customers
    match /businesses/{bizId}/logo {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /businesses/{bizId}/doc_logo {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /logos/{uid}/logo {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/icons/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Job photos — public read for portfolio sharing, write requires auth
    match /job_photos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Lead photos — unauthenticated homeowners upload problem photos
    match /lead_photos/{leadId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // Everything else requires authentication
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
