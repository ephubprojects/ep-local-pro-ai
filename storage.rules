rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Walkie Talkie audio — unauthenticated (WT pages have no login)
    match /wt_audio/{bizId}/{fileName} {
      allow read, write: if true;
    }

    // Logos & icons are public assets shown to unauthenticated customers
    match /businesses/{bizId}/logo {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /businesses/{bizId}/doc_logo {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /logos/{uid}/logo {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/icons/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else requires authentication
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
