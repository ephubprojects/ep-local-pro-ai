rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin: hardcoded email OR role == 'admin' in owners doc
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'ezperfilsystem@gmail.com' ||
        (exists(/databases/$(database)/documents/owners/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Authenticated user
    function isAuth() {
      return request.auth != null;
    }

    // Business owner owns this doc
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── Businesses ──────────────────────────────────────────────────────
    match /businesses/{slug} {
      allow read: if true;  // public — customer ordering page needs this
      allow write: if isAdmin() || isAuth();  // any authenticated owner can update their biz
    }

    // ── Demos ────────────────────────────────────────────────────────────
    match /demos/{demoId} {
      allow read: if true;  // public — demo page needs this
      allow write: if isAdmin();
    }

    // ── Orders ───────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow create: if true;  // customers create orders
      allow read, update: if isAdmin() || isAuth();  // owners query by businessId
      allow delete: if isAdmin();
    }

    // ── Documents (invoices, estimates, contracts) ────────────────────────
    // Business ownership check: the businesses collection is public-read so this is cheap
    function docOwnedByUser(bizId) {
      return bizId is string && bizId.size() > 0
        && get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerId == request.auth.uid;
    }

    match /documents/{docId} {
      allow get: if true;  // public read by ID — shareable live link viewer
      allow list: if isAdmin() || isAuth();
      allow create: if isAdmin() || isAuth();
      allow update: if isAdmin()
        || (isAuth() && resource.data.ownerUid == request.auth.uid)
        || (isAuth() && docOwnedByUser(resource.data.businessId))
        // Unauthenticated customer actions — e-signature or financing request
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['customerSig', 'updatedAt', 'financingRequested', 'financingRequestedAt',
                       'finRequestName', 'finRequestEmail', 'finRequestPhone']);
      allow delete: if isAdmin()
        || (isAuth() && resource.data.ownerUid == request.auth.uid)
        || (isAuth() && docOwnedByUser(resource.data.businessId));
    }

    // ── Business owners (user profiles) ──────────────────────────────────
    match /owners/{uid} {
      allow read: if isAdmin() || isOwner(uid) || isAuth();
      allow write: if isAdmin() || isOwner(uid);
    }

    // ── EP HUB referral tracking ──────────────────────────────────────────
    match /ep_referrals/{refId} {
      allow read: if isAdmin() || isAuth();  // personal accounts read their referrals
      allow create: if true;  // system writes on conversion
      allow update, delete: if isAdmin();
    }

    // ── Category templates (read-only for business owners) ────────────────
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Team employees ────────────────────────────────────────────────────
    match /employees/{empId} {
      allow read: if true;  // employee page needs to validate code without auth
      allow create: if isAuth();
      allow update, delete: if isAdmin()
        || (isAuth() && resource.data.ownerId == request.auth.uid);
    }

    // ── Walkie Talkie messages ────────────────────────────────────────────
    match /wt_messages/{msgId} {
      allow read, create, update: if true;  // employee page is unauthenticated
      allow delete: if isAdmin();
    }

    // ── Global config (calendar setup, etc.) ─────────────────────────────
    match /config/{configId} {
      allow read: if true;   // public booking page reads calendar config
      allow write: if isAdmin();
    }

    // ── Bookings (calendar appointments) ─────────────────────────────────
    match /bookings/{bookingId} {
      allow create: if true;  // customers + AI assistant create bookings unauthenticated
      allow read: if isAdmin() || isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Customers (business owner contact list) ───────────────────────────
    match /customers/{custId} {
      allow read, write: if isAdmin()
        || (isAuth() && (
          resource == null || resource.data.ownerUid == request.auth.uid
        ));
    }

    // ── Document templates ────────────────────────────────────────────────
    match /docTemplates/{tplId} {
      allow read, write: if isAdmin()
        || (isAuth() && (
          resource == null || resource.data.ownerUid == request.auth.uid
        ));
    }

    // ── Job photos (before/after portfolio) ──────────────────────────────
    match /job_photos/{photoId} {
      allow read: if true;  // public — portfolio sharing
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // ── Google My Business setup requests ────────────────────────────────
    match /gmb_requests/{reqId} {
      allow read: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (isAuth() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }
  }
}
